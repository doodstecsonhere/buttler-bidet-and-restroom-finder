{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:d1": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/d1-schema.test.mjs",
    "test:d1-preview": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/d1-preview.test.mjs",
    "test:canonical-import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/canonical-import.test.mjs",
    "test:public-data-contract": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/public-data-contract.test.mjs",
    "test:no-redeploy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/no-redeploy-data-change.test.mjs",
    "test:stage13": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stage13-contributions.test.mjs",
    "test:stage13-identity": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stage13-identity.test.mjs",
    "test:stage13-frontend": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stage13-frontend-auth.test.mjs",
    "test:stage13-contrib-ui": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stage13-contribution-ui.test.mjs",
    "test:stage14c-planner": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stage14c-promotion-planner.test.mjs",
    "test:stage14d-executor": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stage14d-promotion-executor.test.mjs",
    "test:stage14e-endpoint": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stage14e-promotion-endpoint.test.mjs",
    "test:stage14m-rejected-target": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stage14m-rejected-target-safety.test.mjs",
    "test:stage14n-contributor-withdrawal": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stage14n-contributor-withdrawal.test.mjs",
    "test:stage14k-reconciliation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stage14k-canonical-reconciliation.test.mjs",
    "test:stage14k1-parity": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stage14k1-reconciliation-parity.test.mjs",
    "import:canonical:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-canonical.mjs --validate",
    "import:canonical:write": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-canonical.mjs --write",
    "import:canonical:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-canonical.mjs --check",
    "test:map-offline": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/map-offline.test.mjs",
    "test:pwa-build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/pwa-build.test.mjs",
    "generate:d1-seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-d1-seed.mjs --write",
    "check:d1-seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-d1-seed.mjs --check"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
