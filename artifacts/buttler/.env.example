# Buttler 2.0 — Stage 13 frontend: LOCAL browser-side Auth0 configuration.
#
# Vite reads these at BUILD/DEV time and inlines them into the JavaScript
# bundle, so anything in this file is public to anyone who loads the site.
# That is fine for exactly the three values below and for nothing else.
#
#   Copy to `.env.local` (git-ignored) and fill in the SAME three values that
#   already sit in the repository root's `.dev.vars`, with the `VITE_` prefix:
#
#     .dev.vars  AUTH0_DOMAIN         ->  VITE_AUTH0_DOMAIN
#     .dev.vars  AUTH0_CLIENT_ID      ->  VITE_AUTH0_CLIENT_ID
#     .dev.vars  AUTH0_API_AUDIENCE   ->  VITE_AUTH0_AUDIENCE
#
# Why two files: `.dev.vars` is read only by Cloudflare's `wrangler` (the Pages
# Functions that VERIFY a token); Vite never reads it, and Vite's client
# variables must exist at build time to be substituted into the bundle. Same
# three non-secret values, one for each half of the flow. The browser must ask
# for the audience the server expects, or every protected call returns 401.
#
# Leaving any line blank keeps the frontend in its current state: the header
# shows "Log in — coming soon" and no Auth0 code is downloaded at all. That is
# the intended default, and it is what a Cloudflare Pages build sees today
# because these variables are not configured there.
#
# NEVER put any of the following here (or in any VITE_* name):
#   - an Auth0 client secret — a PKCE public browser app has none; do not create one
#   - BUTTLER_MODERATOR_IDS or any other server-only value
#   - any token, cookie, or password
# `scripts/stage13-frontend-auth.test.mjs` fails the build if a server-only name
# appears anywhere in the browser source tree.

# Auth0 tenant domain, no scheme, e.g. your-tenant.us.auth0.com
VITE_AUTH0_DOMAIN=

# Public application client id (not a secret for an Authorization Code + PKCE SPA)
VITE_AUTH0_CLIENT_ID=

# The Auth0 API identifier, requested as the access-token audience.
# Must equal AUTH0_API_AUDIENCE in .dev.vars, e.g. https://buttler-api
VITE_AUTH0_AUDIENCE=
